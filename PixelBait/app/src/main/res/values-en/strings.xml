    <string name="terms_title">Terms and Conditions</string>
    <string name="terms_version">Version 1.0 — July 2025</string>
    <string name="terms_section1_title">1. Use of the Application</string>
    <string name="terms_section1_body">Pixel Bait is a cybersecurity tool designed to analyze QR codes and URLs for malicious threats. Using this application implies full acceptance of these terms.</string>
    <string name="terms_section2_title">2. Data Collection</string>
    <string name="terms_section2_body">The app analyzes URLs scanned using the VirusTotal API. We do not store personal data or share information with unauthorized third parties. Scan history is kept locally for 7 days.</string>
    <string name="terms_section3_title">3. Required Permissions</string>
    <string name="terms_section3_body">The app requires camera access to scan QR codes. This permission is strictly necessary for the core functionality and will not be used for any other purpose.</string>
    <string name="terms_section4_title">4. Limitation of Liability</string>
    <string name="terms_section4_body">Pixel Bait provides analysis based on third-party databases (VirusTotal). We do not guarantee 100%% detection of all threats. The user is responsible for their actions when browsing URLs.</string>
    <string name="btn_next">Next</string>

