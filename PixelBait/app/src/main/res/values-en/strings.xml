    <string name="help_title">How to get your VirusTotal API Key</string>
    <string name="help_step1">1. Go to virustotal.com and create a free account.</string>
    <string name="help_step2">2. Confirm your email address.</string>
    <string name="help_step3">3. Open your profile and select \"API Key\".</string>
    <string name="help_step4">4. Copy the key and paste it into Pixel Bait.</string>

