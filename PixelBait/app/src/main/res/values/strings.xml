    <!-- Guía de ayuda -->
    <string name="help_title">Cómo obtener tu API Key de VirusTotal</string>
    <string name="help_step1">1. Ingresa a virustotal.com y crea una cuenta gratuita.</string>
    <string name="help_step2">2. Confirma tu correo electrónico.</string>
    <string name="help_step3">3. Abre tu perfil y selecciona \"API Key\".</string>
    <string name="help_step4">4. Copia la clave y pégala en Pixel Bait.</string>

